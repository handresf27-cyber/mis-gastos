# Copia este archivo como ".env" y ajusta los valores

# Base de datos:
# - Para probar en tu Mac sin instalar nada, deja esta linea (usa un archivo local SQLite)
DATABASE_URL=sqlite:///./gastos.db

# - Para producción (Render/Neon/Supabase), usa tu URL de Postgres, ejemplo:
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_basededatos

# Clave secreta para firmar los tokens de sesión (login).
# IMPORTANTE: cámbiala por una cadena larga y aleatoria antes de desplegar a producción.
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Cuántos minutos dura la sesión antes de tener que volver a loguearte
ACCESS_TOKEN_EXPIRE_MINUTES=43200
